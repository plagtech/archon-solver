# ─── Required ───────────────────────────────────────────────────────────────
# The solver's signing key. Must be authorized on IntentEngine via setSolver(address, true).
SOLVER_PRIVATE_KEY=0x...
BASE_RPC_URL=https://mainnet.base.org
# WebSocket RPC for event listening (optional; falls back to polling)
BASE_WS_URL=

# ─── Optional ───────────────────────────────────────────────────────────────
PORT=3000
# Milliseconds between matching cycles
MATCH_INTERVAL=3000
# Intents whose deadline is closer than this many seconds are not put into a batch
DEADLINE_BUFFER_SEC=6
# Max calls per JSON-RPC batch (public Base RPC allows 10)
RPC_BATCH_MAX=10
# Private tx submission (check the current URL before using)
FLASHBOTS_RPC=https://rpc.flashbots.net/fast
# Contract addresses
DEPLOYMENT_FILE=./deployments/8453.json

# Contract addresses (override the deployment file)
ROUTER_ADDRESS=
ENGINE_ADDRESS=
VAULT_FACTORY_ADDRESS=
