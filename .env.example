# ─── Required ───────────────────────────────────────────────────────────────
# The solver's signing key. Must be authorized on IntentEngine via setSolver(address, true).
SOLVER_PRIVATE_KEY=0x...
BASE_RPC_URL=https://mainnet.base.org
# Reserved: the event listener polls eth_getLogs over BASE_RPC_URL
BASE_WS_URL=

# ─── Optional ───────────────────────────────────────────────────────────────
PORT=3000
# Milliseconds between matching cycles
MATCH_INTERVAL=3000
# Intents whose deadline is closer than this many seconds are not put into a batch
DEADLINE_BUFFER_SEC=6
# Max calls per JSON-RPC batch (public Base RPC allows 10)
RPC_BATCH_MAX=10
# Send-only RPC for settlement txs (reads still use BASE_RPC_URL). Base's sequencer mempool
# is already private; Flashbots Protect (rpc.flashbots.net) serves Ethereum only, not Base.
PRIVATE_RPC_URL=
# Milliseconds between eth_getLogs polls
EVENT_POLL_INTERVAL=2000
# Publish pool.price when a pair moves at least this many basis points
PRICE_MOVE_BPS=10
# Contract addresses
DEPLOYMENT_FILE=./deployments/8453.json

# Contract addresses (override the deployment file)
ROUTER_ADDRESS=
ENGINE_ADDRESS=
VAULT_FACTORY_ADDRESS=
